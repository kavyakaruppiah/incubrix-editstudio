# Server Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=500

# Optional S3 Configuration (for MinIO / AWS S3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=video-editor-media
S3_REGION=us-east-1

# Database Configuration
DATABASE_URL=sqlite:///./data/app.db

# FFmpeg executable paths (blank uses the project-local tools/ffmpeg/bin, then PATH)
FFMPEG_BINARY=
FFPROBE_BINARY=

# Transcription Configuration
TRANSCRIPTION_BACKEND=auto
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
# Sends audio to Google's recognition service only when explicitly enabled.
GOOGLE_SPEECH_FALLBACK_ENABLED=false

# Prompt planning: auto prefers local Ollama structured plans and falls back to
# deterministic rules when no local model is available. No cloud LLM is used.
INSTRUCTION_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_API_KEY=
# Retry incomplete plans with Qwen Coder. DeepSeek-Coder can be added here when its license and latency fit deployment needs.
OLLAMA_FALLBACK_MODELS=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=45
# Optional cloud fallback used only by INSTRUCTION_PROVIDER=auto after Ollama is unavailable.
# Requests leave this machine and may incur provider charges. Leave blank for local-only behavior.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_API_TIMEOUT_SECONDS=120

# Audio Snapping Configuration
AUDIO_SNAPPING_ENABLED=true
SNAPPING_WINDOW_MS=150
SNAPPING_ENERGY_PERCENTILE=20

# Rendering Policy
RENDER_VIDEO_CODEC=libx264
RENDER_AUDIO_CODEC=aac
RENDER_AUDIO_SAMPLE_RATE=48000
RENDER_CRF=20
RENDER_PRESET=veryfast
RENDER_MAX_DIMENSION=1920
RENDER_TOLERANCE_SECONDS=0.1
